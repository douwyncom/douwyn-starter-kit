{
    "name": "@douwyn/nuxt-api",
    "version": "0.1.0",
    "description": "Nuxt 4 client module for the Douwyn Laravel starter kit",
    "type": "module",
    "license": "Apache-2.0",
    "homepage": "https://douwyn.com",
    "author": {
        "name": "Douwyn Solution Technology",
        "email": "contact@douwyn.com",
        "url": "https://douwyn.com"
    },
    "bugs": {
        "email": "contact@douwyn.com",
        "url": "https://douwyn.com"
    },
    "sideEffects": false,
    "files": [
        "LICENSE",
        "NOTICE",
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/module.d.ts",
            "import": "./dist/module.mjs"
        },
        "./types": {
            "types": "./dist/types.d.ts",
            "import": "./dist/types.mjs"
        },
        "./openapi": {
            "types": "./dist/openapi.d.ts",
            "import": "./dist/openapi.mjs"
        }
    },
    "main": "./dist/module.mjs",
    "types": "./dist/module.d.ts",
    "scripts": {
        "build": "unbuild && tsc -p tsconfig.build.json",
        "test": "bun test",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "ofetch": "^1.4.0"
    },
    "peerDependencies": {
        "nuxt": "^4.0.0"
    },
    "devDependencies": {
        "@nuxt/kit": "^4.0.0",
        "@types/bun": "^1.3.0",
        "typescript": "^5.9.0",
        "unbuild": "^3.0.0",
        "vue": "^3.5.0"
    }
}
