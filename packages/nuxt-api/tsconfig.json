{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "paths": {
      "#app": ["./types/nuxt-app.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "types/**/*.d.ts", "build.config.ts"]
}
