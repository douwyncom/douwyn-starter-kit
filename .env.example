APP_NAME="Douwyn Starter Kit"
APP_ENV=local
APP_KEY=
# During APP_KEY rotation, keep comma-separated old keys here until every
# protected user profile has been re-encrypted and verified.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost

# Comma-separated Nuxt browser origins allowed to call /api/*.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_SUPPORTS_CREDENTIALS=true
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE="UTC"

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
BCRYPT_LIMIT=72

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=douwyn_starter_kit
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Public module media: use "public" for local storage or "s3" for S3-compatible storage.
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Set only to proxy IPs/CIDRs controlled by your infrastructure. Never trust
# arbitrary forwarded headers from the public internet.
TRUSTED_PROXIES=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=10
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum API tokens expire after 30 days by default.
SANCTUM_TOKEN_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=douwyn_
API_VERSION=1.0.0
API_RATE_LIMIT_PER_MINUTE=60

# API lifecycle headers. Keep disabled until a migration window is announced.
# When enabled, API_DEPRECATION_AT is required and must be an ISO 8601 date.
API_DEPRECATED=false
API_DEPRECATION_AT=
API_SUNSET_AT=
API_DEPRECATION_DOCUMENTATION_URL=

# Account lifecycle links open the matching Nuxt pages. Mobile apps may use
# universal/app links for the same URLs and submit the opaque token to the API.
FRONTEND_URL=http://localhost:3000
AUTH_EMAIL_VERIFICATION_MINUTES=60
AUTH_PASSWORD_RESET_MINUTES=30
AUTH_EMAIL_CHANGE_MINUTES=30
# AUTH_EMAIL_VERIFICATION_URL=http://localhost:3000/auth/verify-email
# AUTH_PASSWORD_RESET_URL=http://localhost:3000/auth/reset-password
# AUTH_EMAIL_CHANGE_URL=http://localhost:3000/account/confirm-email-change

# Mobile authentication uses short-lived access tokens and rotating refresh tokens.
AUTH_LEGACY_TOKEN_ENDPOINTS=false
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_IDLE_DAYS=30
AUTH_REFRESH_ABSOLUTE_DAYS=90
AUTH_REFRESH_REPLAY_SECONDS=60
AUTH_REFRESH_LOCK_SECONDS=30
# Optional dedicated HMAC key. Defaults to APP_KEY; changing it signs out mobile devices.
# AUTH_DEVICE_HASH_KEY=
