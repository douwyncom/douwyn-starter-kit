{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "packageManager": "bun@1.4.4",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "audit:js": "bun scripts/audit-javascript.mjs",
        "audit:js:test": "bun test scripts/audit-javascript.test.mjs",
        "api:generate": "bun run api:spec && bun run api:types",
        "api:spec": "php artisan scramble:export --path=packages/nuxt-api/openapi.json",
        "api:types": "openapi-typescript packages/nuxt-api/openapi.json --output packages/nuxt-api/src/openapi.ts",
        "build": "vite build",
        "dev": "vite",
        "nuxt-api:build": "bun run --cwd packages/nuxt-api build",
        "nuxt-api:test": "bun run --cwd packages/nuxt-api test",
        "nuxt-api:typecheck": "bun run --cwd packages/nuxt-api typecheck"
    },
    "overrides": {
        "@nuxt/devtools": "^3.3.1",
        "browserslist": "^4.28.9",
        "form-data": ">=4.0.6",
        "js-yaml": "^4.3.2",
        "nanoid": "^3.3.16",
        "nuxt": "^4.6.3",
        "picomatch": "^4.0.5",
        "postcss": "^8.5.23",
        "rollup": ">=4.59.0",
        "svgo": "^4.1.0",
        "tar": "^7.5.21"
    },
    "devDependencies": {
        "@nuxt/kit": "^4.6.3",
        "@tailwindcss/vite": "^4.3.3",
        "@types/bun": "^1.4.4",
        "axios": "^1.20.0",
        "brace-expansion": "^5.0.12",
        "concurrently": "^9.2.5",
        "laravel-vite-plugin": "^2.1.0",
        "openapi-typescript": "^7.13.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "unbuild": "^3.6.1",
        "vite": "^7.3.7",
        "vue": "^3.5.44"
    },
    "dependencies": {
        "@fontsource-variable/manrope": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "ofetch": "^1.5.1",
        "vite-plugin-full-reload": "^1.2.0"
    }
}
