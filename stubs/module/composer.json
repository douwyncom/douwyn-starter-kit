{
    "name": "douwyncom/starter-kit-example",
    "type": "library",
    "description": "Example private module for Douwyn Starter Kit.",
    "license": "proprietary",
    "homepage": "https://douwyn.com",
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*",
        "composer-runtime-api": "^2.2",
        "douwyncom/starter-kit-platform": "^2.1",
        "filament/filament": "^5.0",
        "illuminate/support": "^13.0"
    },
    "support": {
        "email": "contact@douwyn.com"
    },
    "autoload": {
        "psr-4": {
            "Douwyn\\StarterKit\\Modules\\Example\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Douwyn\\StarterKit\\Modules\\Example\\ExampleServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
