{
    "name": "douwyncom/douwyn-starter-kit",
    "type": "project",
    "description": "A modern Laravel + Filament v5 starter kit with authentication, role & permission management, multi-factor authentication, and extensible architecture for building scalable SaaS applications.",
    "keywords": [
        "laravel",
        "filament",
        "filament v5",
        "starter kit",
        "saas",
        "rbac",
        "multi-factor authentication",
        "douwyn",
        "admin panel"
    ],
    "license": "Apache-2.0",
    "homepage": "https://douwyn.com",
    "authors": [
        {
            "name": "Douwyn Solution Technology Co., Ltd",
            "email": "ceo.founder@douwyn.com",
            "role": "Founder & Lead Developer"
        }
    ],
    "support": {
        "email": "contact@douwyn.com"
    },
    "require": {
        "php": "^8.5",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "composer-runtime-api": "^2.2",
        "bacon/bacon-qr-code": "^3.0",
        "composer/semver": "^3.4",
        "dedoc/scramble": "^0.13.33",
        "douwyncom/starter-kit-hotel-booking": "@dev",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "laravel/prompts": "^0.3.11",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.25.1",
        "pragmarx/google2fa": "^9.0",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-permission": "^6.24"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel-lang/lang": "^15.28",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "provide": {
        "douwyncom/starter-kit-platform": "2.2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Douwyn\\StarterKit\\": "src/StarterKit/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "check:public-boundary": "@php scripts/check-public-boundary.php",
        "check:runtime": "@php scripts/check-runtime.php",
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install",
            "bun run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "starter-kit-hotel-booking",
            "type": "path",
            "url": "modules/starter-kit-hotel-booking"
        }
    ]
}
