{
    "name": "douwyncom/douwyn-starter-kit",
    "type": "project",
    "description": "A modern Laravel + Filament v5 starter kit with authentication, role & permission management, multi-factor authentication, and extensible architecture for building scalable SaaS applications.",
    "keywords": [
        "laravel",
        "filament",
        "filament v5",
        "starter kit",
        "saas",
        "rbac",
        "multi-factor authentication",
        "douwyn",
        "admin panel"
    ],
    "license": "Apache-2.0",
    "homepage": "https://douwyn.com",
    "authors": [
        {
            "name": "Douwyn Solution Technology Co., Ltd",
            "email": "ceo.founder@douwyn.com",
            "role": "Founder & Lead Developer"
        }
    ],
    "support": {
        "email": "contact@douwyn.com"
    },
    "require": {
        "bacon/bacon-qr-code": "^3.0",
        "composer-runtime-api": "^2.2",
        "composer/semver": "^3.4",
        "dedoc/scramble": "^0.13.33",
        "douwyncom/starter-kit-discord": "^0.1@dev",
        "douwyncom/starter-kit-domains": "^0.1@dev",
        "douwyncom/starter-kit-hotel-booking": "^1.0@dev",
        "douwyncom/starter-kit-licensing": "^0.1@dev",
        "douwyncom/starter-kit-telegram": "^1.1@dev",
        "douwyncom/starter-kit-whatsapp": "^0.1@dev",
        "douwyncom/starter-kit-zalo-oa": "^0.1@dev",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "filament/filament": "^5.8.4",
        "laravel/framework": "^13.0",
        "laravel/octane": "^2.19",
        "laravel/prompts": "^0.3.11",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.25.1",
        "php": "^8.5",
        "pragmarx/google2fa": "^9.0",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-permission": "^6.24"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel-lang/lang": "^15.28",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "provide": {
        "douwyncom/starter-kit-platform": "2.2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Douwyn\\StarterKit\\": "src/StarterKit/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "check:octane": "@php -d opcache.enable_cli=1 scripts/check-runtime.php --octane",
        "check:public-boundary": "@php scripts/check-public-boundary.php",
        "check:runtime": "@php scripts/check-runtime.php",
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install",
            "bun run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "test:domains": "@php vendor/bin/phpunit --configuration modules/starter-kit-domains/phpunit.xml",
        "test:hotel-booking": "@php artisan test modules/starter-kit-hotel-booking/tests",
        "test:telegram": "@php vendor/bin/phpunit --configuration modules/starter-kit-telegram/phpunit.xml",
        "test:whatsapp": "@php vendor/bin/phpunit --configuration modules/starter-kit-whatsapp/phpunit.xml",
        "test:licensing": "@php vendor/bin/phpunit --configuration modules/starter-kit-licensing/phpunit.xml",
        "test:app-services": "@php modules/app-services-integration/tests/run.php",
        "queue:domains": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan queue:work database-domains --queue=domains --timeout=1860 --tries=50"
        ],
        "queue:telegram": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan queue:work database --queue=telegram-inbound,telegram-outbound,telegram-broadcast,telegram-campaigns --timeout=80 --tries=3"
        ],
        "queue:whatsapp": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan queue:work database --queue=whatsapp-inbound,whatsapp-outbound,whatsapp-broadcast,whatsapp-campaigns --timeout=60"
        ],
        "test:zalo-oa": "@php vendor/bin/phpunit --configuration modules/starter-kit-zalo-oa/phpunit.xml",
        "queue:zalo-oa": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan queue:work --queue=zalo-oa-inbound,zalo-oa-outbound,zalo-oa-campaigns --timeout=65"
        ],
        "test:discord": "@php vendor/bin/phpunit --configuration modules/starter-kit-discord/phpunit.xml",
        "queue:discord": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan queue:work database --queue=discord-inbound,discord-outbound,discord-broadcast,discord-campaigns --timeout=60"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "starter-kit-local": {
            "type": "path",
            "url": "modules/starter-kit-*",
            "options": {
                "symlink": true,
                "versions": {
                    "douwyncom/starter-kit-domains": "0.1.x-dev",
                    "douwyncom/starter-kit-hotel-booking": "1.0.x-dev",
                    "douwyncom/starter-kit-telegram": "1.1.x-dev",
                    "douwyncom/starter-kit-whatsapp": "0.1.x-dev",
                    "douwyncom/starter-kit-licensing": "0.1.x-dev",
                    "douwyncom/starter-kit-zalo-oa": "0.1.x-dev",
                    "douwyncom/starter-kit-discord": "0.1.x-dev"
                }
            }
        }
    }
}
